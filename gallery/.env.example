# Environment variables for the WebJs gallery app.
# Copy to .env: cp .env.example .env

PORT=5005
AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars
DATABASE_URL=file:./db/dev.db

# The sessions card signs its cookie with this. A dev fallback keeps a fresh
# checkout booting, but the card throws at module load in production without it.
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# The file-storage card signs its download links with this (dev fallback too).
FILE_URL_SECRET=change-me-to-a-random-string-at-least-32-chars

# Uncomment for OAuth login on the auth card:
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
