# Environment variables for the WebJs gallery app.
# Copy to .env: cp .env.example .env

PORT=5005
AUTH_SECRET=change-me-to-a-random-string-at-least-32-chars
DATABASE_URL=file:./db/dev.db

# Uncomment for OAuth login on the auth card:
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
