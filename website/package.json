{
  "name": "@webjsdev/website",
  "version": "0.1.1",
  "type": "module",
  "private": true,
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "dev": "webjs dev --port ${PORT:-5001}",
    "start": "webjs start",
    "test": "webjs test",
    "test:browser": "webjs test --browser",
    "css:build": "tailwindcss -i ./public/input.css -o ./public/tailwind.css --minify"
  },
  "webjs": {
    "redirects": [
      {
        "source": "/why",
        "destination": "/why-webjs",
        "permanent": true
      },
      {
        "source": "/docs/ui",
        "destination": "/ui",
        "permanent": true
      }
    ],
    "dev": {
      "before": [
        "node scripts/copy-registry.mjs",
        "npm run css:build"
      ],
      "regenerate": [
        {
          "output": "public/tailwind.css",
          "command": "node scripts/copy-registry.mjs && tailwindcss -i ./public/input.css -o ./public/tailwind.css --minify",
          "inputs": [
            "app",
            "components",
            "lib",
            "modules",
            "../packages/ui/packages/registry/components",
            "public/input.css"
          ]
        }
      ],
      "watch": [
        "../blog"
      ]
    },
    "start": {
      "before": [
        "node scripts/copy-registry.mjs",
        "npm run css:build"
      ]
    }
  },
  "dependencies": {
    "@webjsdev/cli": "^0.10.0",
    "@webjsdev/core": "^0.7.0",
    "@webjsdev/server": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@web/test-runner": "^0.20.0",
    "@web/test-runner-playwright": "^0.11.0",
    "playwright": "^1.59.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
